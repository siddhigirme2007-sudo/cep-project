# Copy this file to .env and fill in real values. Never commit .env.
# The app works fine with NO values set here — it runs in DEMO_MODE
# with safe template-based explanations and offline translation.

# Optional: enables live Gemini AI explanations and fluent Marathi/Hindi translations.
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Optional: enables Anthropic Claude explanations.
ANTHROPIC_API_KEY=

# Optional: override the default model used for explanations (e.g. gemini-1.5-flash).
MEDIEXPLAIN_LLM_MODEL=gemini-1.5-flash

# Optional: path to the Tesseract executable, only needed on Windows if
# it is not already on your PATH after installation, e.g.:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
